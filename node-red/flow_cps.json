  {
    "id": "cps_fn_ts",
    "type": "function",
    "z": "cps_tab_flow",
    "name": "Carimbo de tempo (servidor)",
    "func": "// Associa o horário de RECEPÇÃO (relógio do servidor Node-RED) a cada mensagem\nconst p = msg.payload;\nif (typeof p !== 'object' || p === null || p.id === undefined) {\n    node.warn('Mensagem sem id ignorada: ' + JSON.stringify(p));\n    return null;\n}\nconst agora = new Date();\np.ts_ms = agora.getTime();\np.ts = agora.toISOString();\np.hora = agora.toLocaleTimeString('pt-BR');\nmsg.sensor = String(p.id);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 100,
    "wires": [
      [
        "cps_fn_v1",
        "cps_fn_v2",
        "cps_fn_csv",
        "cps_fn_tab",
        "cps_debug"
      ]
    ]
