  {
    "id": "cps_tpl_status",
    "type": "ui_template",
    "z": "cps_tab_flow",
    "group": "cps_g_status",
    "name": "Indicador gateway",
    "order": 1,
    "width": "6",
    "height": "2",
    "format": "<div class=\"gw\">\n  <span class=\"gw-led\" ng-class=\"{'on': msg.payload.online, 'off': msg.payload && !msg.payload.online}\"></span>\n  <span class=\"gw-txt\">{{ !msg.payload ? 'Aguardando...' : (msg.payload.online ? 'ONLINE' : 'OFFLINE') }}</span>\n  <div class=\"gw-hora\" ng-if=\"msg.payload\">desde {{msg.payload.hora}}</div>\n</div>\n<style>\n.gw { display:flex; align-items:center; gap:12px; flex-wrap:wrap; font-size: 22px; font-weight: 700; }\n.gw-led { width: 26px; height: 26px; border-radius: 50%; background: #888; }\n.gw-led.on  { background: #2ecc40; box-shadow: 0 0 12px #2ecc40; }\n.gw-led.off { background: #ff4136; box-shadow: 0 0 12px #ff4136; }\n.gw-hora { width:100%; font-size: 13px; font-weight: 400; opacity: .7; }\n</style>",
    "storeOutMessages": true,
    "fwdInMessages": false,
