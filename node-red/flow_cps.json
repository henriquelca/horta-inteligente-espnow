  {
    "id": "cps_fn_csv",
    "type": "function",
    "z": "cps_tab_flow",
    "name": "Linha CSV",
    "func": "// Uma linha CSV por mensagem; o arquivo fica na pasta do usuário\nconst casa = env.get('HOME') || env.get('USERPROFILE') || '.';\nconst arquivo = casa + '/cps_log_equipeX.csv';\nconst p = msg.payload;\nconst campo = v => (v === undefined || v === null) ? '' : String(v);\nconst linhas = [];\nif (!context.get('cabecalho')) {   // escreve o cabeçalho a cada (re)deploy\n    context.set('cabecalho', true);\n    linhas.push({ filename: arquivo, payload: 'ts_iso,ts_ms,id,cont,v1,v2,hop,rep,rssi' });\n}\nlinhas.push({ filename: arquivo, payload: [p.ts, p.ts_ms, p.id, p.cont, p.v1, p.v2, p.hop, p.rep, p.rssi].map(campo).join(',') });\nreturn [linhas];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 720,
    "y": 180,
    "wires": [
      [
        "cps_file"
      ]
    ]
  },
