  {
    "id": "cps_fn_status",
    "type": "function",
    "z": "cps_tab_flow",
    "name": "online/offline",
    "func": "// LWT do gateway: \"online\" ao conectar, \"offline\" publicado pelo broker se ele cair\nconst txt = String(msg.payload).trim().toLowerCase();\nmsg.payload = { online: txt === 'online', texto: txt, hora: new Date().toLocaleString('pt-BR') };\nflow.set('gateway_online', msg.payload.online);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
