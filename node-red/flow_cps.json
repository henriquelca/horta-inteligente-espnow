    "id": "cps_file",
    "type": "file",
    "z": "cps_tab_flow",
    "name": "Log em arquivo (~/cps_log_*.csv)",
    "filename": "",
    "appendNewline": true,
    "createDir": true,
    "overwriteFile": "false",
